{
  "name": "hipalantir",
  "version": "10.9.21",
  "description": "A lightweight Bun-native Discord selfbot library — built on Bun/Node builtins, with only the DAVE native binary as dependency",
  "main": "./src/index.js",
  "types": "./typings/index.d.ts",
  "type": "commonjs",
  "scripts": {
    "start": "bun run src/index.js",
    "test": "bun test",
    "test:network": "PALANTIR_NETWORK_TESTS=1 bun test test/network.test.js",
    "docs": "docgen --source src --custom docs/index.yml --output docs/main.json"
  },
  "files": [
    "src",
    "typings"
  ],
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScarysMonsters/palantir.js.git"
  },
  "keywords": [
    "discord",
    "selfbot",
    "selfbot v13",
    "djs",
    "api",
    "bot",
    "node",
    "bun",
    "discord.js",
    "zero-dependency",
    "lightweight",
    "client",
    "discordapp",
    "palantir"
  ],
  "author": "ScarysMonsters",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/ScarysMonsters/palantir.js/issues"
  },
  "homepage": "https://github.com/ScarysMonsters/palantir.js#readme",
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@snazzah/davey": "^0.1.12"
  },
  "devDependencies": {
    "@discordjs/docgen": "^0.11.1"
  },
  "optionalDependencies": {
    "opusscript": "^0.1.1",
    "@snazzah/davey-darwin-arm64": "0.1.12",
    "@snazzah/davey-darwin-x64": "0.1.12",
    "@snazzah/davey-linux-x64-gnu": "0.1.12",
    "@snazzah/davey-linux-x64-musl": "0.1.12",
    "@snazzah/davey-win32-x64-msvc": "0.1.12"
  },
  "patchedDependencies": {
    "jsdoc@3.6.11": "patches/jsdoc@3.6.11.patch"
  }
}
